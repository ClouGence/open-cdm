SEMI      : ';';
COMMA     : ',';
DOT       : '.';
LPAREN    : '(';
RPAREN    : ')';
LBRACE    : '{';
RBRACE    : '}';
STAR      : '*';
PLUS_PLUS : '++';
PLUS      : '+';
JSON_TEXT_ARROW : '->>';
JSON_ARROW : '->';
MINUS     : '-';
SLASH     : '/';
PERCENT   : '%';
NAMED_ARGUMENT_ARROW : '=>';
EQ        : '=';
NEQ       : '<>' | '!=' | '^=';
LTE       : '<=';
GTE       : '>=';
LT        : '<';
GT        : '>';
CONCAT    : '||';
AND_OP    : '&&';
NOT_OP    : '!';
SHIFT_LEFT : '<<';
SHIFT_RIGHT : '>>';
BIT_AND   : '&';
BIT_OR    : '|';
BIT_XOR   : '^';
BIT_NOT   : '~';
ASSIGN    : ':=';
DOUBLE_COLON : '::';
COLON     : ':';
JSON_CONTAINS : '@>';
AT        : '@';
QUESTION  : '?';
BACKTICK  : '`';

HEX_LITERAL
    : '0' [xX] [0-9A-Fa-f]+
    ;

HEX_STRING_LITERAL
    : X '\'' [0-9A-Fa-f]* '\''
    ;

NUMBER
    : DIGIT+ ('.' DIGIT*)? ([eE] [+-]? DIGIT+)? [fFdD]?
    | '.' DIGIT+ ([eE] [+-]? DIGIT+)? [fFdD]?
    ;

STRING
    : (N | E | '_' [A-Za-z] [A-Za-z0-9_]*)? '\'' (~'\'' | '\'' '\'')* '\''
    | Q '\'' '[' ~[\]]* ']' '\''
    | Q '\'' '(' ~[)]* ')' '\''
    | Q '\'' '{' ~[}]* '}' '\''
    | Q '\'' '<' ~[>]* '>' '\''
    | Q '\'' '!' ~[!]* '!' '\''
    | Q '\'' '#' ~[#]* '#' '\''
    | Q '\'' '~' ~[~]* '~' '\''
    | Q '\'' '/' ~[/]* '/' '\''
    | Q '\'' '$' ~[$]* '$' '\''
    | Q '\'' '^' ~[^]* '^' '\''
    | Q '\'' '|' ~[|]* '|' '\''
    | Q '\'' ':' ~[:]* ':' '\''
    | Q '\'' ';' ~[;]* ';' '\''
    | Q '\'' '?' ~[?]* '?' '\''
    | Q '\'' '@' ~[@]* '@' '\''
    | Q '\'' '%' ~[%]* '%' '\''
    | Q '\'' '&' ~[&]* '&' '\''
    | Q '\'' '+' ~[+]* '+' '\''
    | Q '\'' '-' ~[-]* '-' '\''
    | Q '\'' '=' ~[=]* '=' '\''
    | Q '\'' ',' ~[,]* ',' '\''
    | Q '\'' '.' ~[.]* '.' '\''
    | Q '\'' '`' ~[`]* '`' '\''
    ;

DOUBLE_QUOTED_ID
    : '"' ('""' | ~'"')* '"'
    ;

BRACKET_QUOTED_ID
    : '[' ~[\]\r\n]* ']'
    ;

BIND_VARIABLE
    : ':' (ID | DIGIT+ | '"' ('""' | ~'"')* '"')
    ;

LOCAL_TEMP_ID
    : '#' [A-Za-z0-9_$\u0080-\uFFFF] [A-Za-z0-9_$#\u0080-\uFFFF]*
    ;

ID
    : [A-Za-z_\u0080-\uFFFF] [A-Za-z0-9_$#\u0080-\uFFFF]*
    ;

LINE_COMMENT
    : '--' ~[\r\n]* -> channel(COMMENTS)
    ;

C_LINE_COMMENT
    : '//' ~[\r\n]* -> channel(COMMENTS)
    ;

BLOCK_COMMENT
    : '/*' .*? '*/' -> channel(COMMENTS)
    ;

WS
    : [ \t\f\r\n]+ -> channel(HIDDEN)
    ;

fragment DIGIT : [0-9];
fragment A : [aA];
fragment B : [bB];
fragment C : [cC];
fragment D : [dD];
fragment E : [eE];
fragment F : [fF];
fragment G : [gG];
fragment H : [hH];
fragment I : [iI];
fragment J : [jJ];
fragment K : [kK];
fragment L : [lL];
fragment M : [mM];
fragment N : [nN];
fragment O : [oO];
fragment P : [pP];
fragment Q : [qQ];
fragment R : [rR];
fragment S : [sS];
fragment T : [tT];
fragment U : [uU];
fragment V : [vV];
fragment W : [wW];
fragment X : [xX];
fragment Y : [yY];
fragment Z : [zZ];
