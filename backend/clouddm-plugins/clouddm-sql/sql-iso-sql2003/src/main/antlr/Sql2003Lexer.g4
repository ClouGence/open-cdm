// --- Basic tokens ---
SEMI        : ';';
LEFT_PAREN  : '(';
RIGHT_PAREN : ')';
COMMA       : ',';
DOT         : '.';
EXPLAIN     : 'EXPLAIN';
PLAN        : 'PLAN';
STATEMENT_NAME : 'STATEMENT_NAME';

IDENTIFIER
    : [a-zA-Z_] [a-zA-Z0-9_]*
    ;

NUMBER
    : DIGIT+ ( '.' DIGIT* )?
    | '.' DIGIT+
    ;

fragment DIGIT : [0-9];

STRING
    : ['] (~['] | [']['])* [']
    ;

WS
    : [ \t\r\n]+ -> channel(HIDDEN)
    ;

LINE_COMMENT
    : '--' ~[\r\n]* -> channel(HIDDEN)
    ;

BLOCK_COMMENT
    : '/*' .*? '*/' -> channel(HIDDEN)
    ;
