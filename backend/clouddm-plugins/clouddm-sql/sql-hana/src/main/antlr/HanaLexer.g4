NO: 'NO';
NOT: 'NOT';
NOWAIT: 'NOWAIT';
NULL: 'NULL';
NULLS: 'NULLS';
OF: 'OF';
OFFSET: 'OFFSET';
OLD: 'OLD';
ON: 'ON';
ONLY: 'ONLY';
OPTION: 'OPTION';
OR: 'OR';
ORDER: 'ORDER';
OUT: 'OUT';
OUTER: 'OUTER';
OVER: 'OVER';
PARALLEL: 'PARALLEL';
PARTITION: 'PARTITION';
PLAN: 'PLAN';
PRIMARY: 'PRIMARY';
PROCEDURE: 'PROCEDURE';
READ: 'READ';
READS: 'READS';
REFERENCES: 'REFERENCES';
REFERENCING: 'REFERENCING';
RENAME: 'RENAME';
REPEATABLE: 'REPEATABLE';
REPLACE: 'REPLACE';
RESTRICT: 'RESTRICT';
RETURN: 'RETURN';
RETURNS: 'RETURNS';
RIGHT: 'RIGHT';
ROLLBACK: 'ROLLBACK';
ROW: 'ROW';
ROWCOUNT: 'ROWCOUNT';
SAVEPOINT: 'SAVEPOINT';
SCHEMA: 'SCHEMA';
SECURITY: 'SECURITY';
SELECT: 'SELECT';
SEQUENCE: 'SEQUENCE';
SEQUENTIAL: 'SEQUENTIAL';
SERIALIZABLE: 'SERIALIZABLE';
SET: 'SET';
SESSION: 'SESSION';
SHARE: 'SHARE';
SQLEXCEPTION: 'SQLEXCEPTION';
SQLSCRIPT: 'SQLSCRIPT';
START: 'START';
STATEMENT: 'STATEMENT';
STATEMENT_NAME: 'STATEMENT_NAME';
SYNONYM: 'SYNONYM';
TABLE: 'TABLE';
TEMPORARY: 'TEMPORARY';
THEN: 'THEN';
TO: 'TO';
TOP: 'TOP';
TOTAL: 'TOTAL';
TRANSACTION: 'TRANSACTION';
TRIGGER: 'TRIGGER';
TRUE: 'TRUE';
TRUNCATE: 'TRUNCATE';
UNION: 'UNION';
UNIQUE: 'UNIQUE';
UNSET: 'UNSET';
UPDATE: 'UPDATE';
UPSERT: 'UPSERT';
USING: 'USING';
VALUES: 'VALUES';
VIEW: 'VIEW';
WAIT: 'WAIT';
WHEN: 'WHEN';
WHERE: 'WHERE';
WHILE: 'WHILE';
WITH: 'WITH';
WORK: 'WORK';
WRITE: 'WRITE';
SQL: 'SQL';
SEMI: ';'; LPAREN: '('; RPAREN: ')'; COMMA: ','; DOT: '.';
STAR: '*'; EQ: '='; NE: '<>' | '!='; LE: '<='; GE: '>='; LT: '<'; GT: '>';
PLUS: '+'; MINUS_OP: '-'; CONCAT: '||'; DIV: '/'; MOD: '%'; ASSIGN: ':='; COLON: ':'; QUESTION: '?';
DECIMAL: [0-9]+ '.' [0-9]+;
INTEGER: [0-9]+;
STRING: '\'' ('\'\'' | ~'\'')* '\'';
QUOTED_IDENTIFIER: '"' ('""' | ~'"')* '"';
WORD: [#A-Z_\u0080-\uFFFF] [A-Z_0-9$#\u0080-\uFFFF]*;
LINE_COMMENT: '--' ~[\r\n]* -> channel(HIDDEN);
BLOCK_COMMENT_START: '/*' -> more, pushMode(IN_COMMENT);
WS: [ \t\r\n]+ -> channel(HIDDEN);
// Keep lexical failures in the parser error path, including unfinished quotes at EOF.
SYMBOL: [&^~\u005B\u005D{}$];
INVALID_CHARACTER: .;

// An unfinished comment must reach the parser as an error, not disappear at EOF.
mode IN_COMMENT;
BLOCK_COMMENT_END: '*/' -> type(BLOCK_COMMENT), channel(HIDDEN), popMode;
COMMENT_CHARACTER: . -> more;
COMMENT_EOF: EOF -> type(UNTERMINATED_COMMENT), popMode;
