<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <logger name="net.hasor.dbvisitor.jdbc.core.JdbcTemplate" level="off"/>

    <!-- Console Output Log -->
    <appender name="consoleOut" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msgContent%n</pattern>
        </layout>
    </appender>

    <!-- Log Output Level -->
    <root level="Info">
        <appender-ref ref="consoleOut"/>
    </root>
</configuration>