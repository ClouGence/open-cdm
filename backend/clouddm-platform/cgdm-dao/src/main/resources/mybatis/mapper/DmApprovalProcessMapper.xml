<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.approval.DmApprovalProcessMapper">
    <resultMap id="ticketProcessDO" type="com.clougence.clouddm.platform.dal.model.approval.DmApprovalProcessDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="ticket_id" property="ticketId"/>
        <result column="ticket_stage" property="ticketStage"
                javaType="com.clougence.clouddm.platform.dal.model.approval.ApprovalStage"/>
        <result column="finish_time" property="finishTime"/>
        <result column="stage_context" property="stageContext"/>
        <result column="process_status" property="processStatus"
                javaType="com.clougence.clouddm.platform.dal.model.approval.ApprovalProcessStatus"/>
    </resultMap>

    <sql id="all_col">
        id,
        gmt_create,
        gmt_modified,
        ticket_id,
        ticket_stage,
        finish_time,
        stage_context,
        process_status
    </sql>

    <select id="queryByStage" resultMap="ticketProcessDO">
        SELECT
            <include refid="all_col"/>
        FROM
            dm_approval_process
        WHERE
            ticket_id    = #{ticketId}
            AND
            ticket_stage = #{ticketStage,javaType=com.clougence.clouddm.platform.dal.model.approval.ApprovalStage}
            AND
            deleted      = false
    </select>

    <select id="listByTicketId" resultMap="ticketProcessDO">
        SELECT
            <include refid="all_col"/>
        FROM
            dm_approval_process
        WHERE
            ticket_id = #{ticketId}
            AND
            deleted   = false
        ORDER BY id
    </select>

    <update id="updateContextById">
        UPDATE
            dm_approval_process
        SET
            stage_context = #{context}
        WHERE
            id = #{id}
    </update>
    <update id="updateModified">
        UPDATE
            dm_approval_process
        SET
            gmt_modified = NOW()
        WHERE
            id = #{id}
    </update>
    <update id="updateNotEndProcessByTicketId">
        UPDATE
            dm_approval_process
        SET
            process_status = #{status}
        WHERE
            ticket_id      = #{ticketId}
            AND
            process_status = 'INIT'
    </update>
    <update id="updateProcessStatus">
        UPDATE
            dm_approval_process
        SET
            process_status = #{status},
            stage_context  = #{context},
            finish_time    = #{finishTime}
        WHERE
            id = #{id}
    </update>
</mapper>
