<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.auth.DmAuthCsrfTokenMapper">
    <resultMap id="dmCsrfTokenDO" type="com.clougence.clouddm.platform.dal.model.auth.DmAuthCsrfTokenDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="token" property="token"/>
        <result column="jump_url" property="jumpUrl"/>
        <result column="secret_token" property="secretToken"/>
    </resultMap>

    <sql id="rdpCsrfToken">
        id,
        gmt_create,
        gmt_modified,
        token,
        jump_url,
        secret_token
    </sql>

    <select id="queryByToken" resultMap="dmCsrfTokenDO">
        SELECT
            <include refid="rdpCsrfToken"/>
        FROM
            dm_auth_csrf_token
        WHERE
            token = #{token}
        LIMIT 1
    </select>

    <delete id="deleteByToken">
        DELETE FROM
            dm_auth_csrf_token
        WHERE
            token = #{token}
    </delete>

    <delete id="deleteBeforeTime">
        DELETE FROM
            dm_auth_csrf_token
        WHERE
            gmt_modified <![CDATA[ <= ]]> #{date}
    </delete>

    <update id="updateToken">
        UPDATE
            dm_auth_csrf_token
        SET
            gmt_modified = NOW(),
            jump_url     = #{data.jumpUrl},
            secret_token = #{data.secretToken}
        WHERE
            token = #{token}
    </update>
</mapper>
