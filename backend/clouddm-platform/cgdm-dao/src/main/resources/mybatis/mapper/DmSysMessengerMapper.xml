<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.system.DmSysMessengerMapper">
    <resultMap id="dmMessengerDO" type="com.clougence.clouddm.platform.dal.model.system.DmSysMessengerDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="owner_uid" property="ownerUid"/>
        <result column="im_type" property="imType" javaType="com.clougence.clouddm.platform.dal.model.system.ImType"/>
        <result column="im_display" property="imDisplay"/>
        <result column="webhook" property="webhook"/>
        <result column="secret" property="secret"/>
        <result column="enable" property="enable"/>
    </resultMap>

    <sql id="dmMessengerColumns">
        id,
        gmt_create,
        gmt_modified,
        owner_uid,
        im_type,
        im_display,
        webhook,
        secret,
        enable
    </sql>

    <select id="queryMessengerByOwner" resultMap="dmMessengerDO">
        SELECT
            <include refid="dmMessengerColumns"/>
        FROM
            dm_sys_messenger
        WHERE
            owner_uid = #{ownerUid}
        ORDER BY
            im_type ASC, gmt_create ASC
    </select>

    <select id="queryMessengerByOwnerAndType" resultMap="dmMessengerDO">
        SELECT
            <include refid="dmMessengerColumns"/>
        FROM
            dm_sys_messenger
        WHERE
            owner_uid = #{ownerUid}
            <if test="imType != null">
                AND
                im_type = #{imType, javaType=com.clougence.clouddm.platform.dal.model.system.ImType}
            </if>
        ORDER BY
            im_type ASC, gmt_create ASC
    </select>

    <select id="queryImById" resultMap="dmMessengerDO">
        SELECT
            <include refid="dmMessengerColumns"/>
        FROM
            dm_sys_messenger
        WHERE
            owner_uid = #{ownerUid}
            AND
            id        = #{imId}
        ORDER BY
            im_type ASC, gmt_create ASC
    </select>

    <delete id="deleteByOwnerAndId">
        DELETE FROM
            dm_sys_messenger
        WHERE
            id        = #{imId}
            AND
            owner_uid = #{ownerUid}
    </delete>

    <update id="updateDisplayByOwnerAndId">
        UPDATE
            dm_sys_messenger
        SET
            im_display   = #{newData},
            gmt_modified = NOW()
        WHERE
            id        = #{imId}
            AND
            owner_uid = #{ownerUid}
    </update>

    <update id="updateWebhookUrlByOwnerAndId">
        UPDATE
            dm_sys_messenger
        SET
            webhook      = #{newData},
            secret       = #{newSecret},
            gmt_modified = NOW()
        WHERE
            id        = #{imId}
            AND
            owner_uid = #{ownerUid}
    </update>
</mapper>
