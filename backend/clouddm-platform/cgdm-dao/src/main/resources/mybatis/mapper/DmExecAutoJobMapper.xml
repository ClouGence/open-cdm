<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.execution.DmExecAutoJobMapper">
    <resultMap id="autoExecJobDO" type="com.clougence.clouddm.platform.dal.model.execution.DmExecAutoJobDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="data_source_id" property="dataSourceId"/>
        <result column="uid" property="uid"/>
        <result column="depend_on_biz_id" property="dependOnBizId"/>
        <result column="query_id" property="queryId"/>
        <result column="status" property="status"/>
        <result column="biz_id" property="bizId"/>
        <result column="end_time" property="endTime"/>
        <result column="last_report_time" property="lastReportTime"/>
        <result column="worker_seq_number" property="workerSeqNumber"/>
        <result column="config" property="config"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="exec_type" property="execType"
                javaType="com.clougence.clouddm.platform.dal.model.execution.AutoExecType"/>
        <result column="schedule_time" property="scheduleTime"/>
        <result column="levels" property="levels"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="normal" property="normal"/>
    </resultMap>

    <sql id="sqlJob">
        id,
        gmt_create,
        gmt_modified,
        data_source_id,
        uid,
        levels,
        query_id,
        biz_id,
        depend_on_biz_id,
        status,
        end_time,
        last_report_time,
        worker_seq_number,
        config,
        exec_type,
        schedule_time,
        normal
    </sql>

    <select id="queryById" resultMap="autoExecJobDO">
        SELECT
            <include refid="sqlJob"/>
        FROM
            dm_exec_auto_job
        WHERE
            id = #{jobId}
    </select>

    <update id="updateJobStatus">
        UPDATE
            dm_exec_auto_job
        SET
            status = #{status}
        WHERE
            id = #{jobId}
    </update>

    <update id="markJobFailedIfActive">
        UPDATE
            dm_exec_auto_job
        SET
            status = 'FAILED'
        WHERE
            id         = #{jobId}
            AND
            status NOT IN ('FAILED', 'FINISH', 'TERMINATION')
    </update>

    <update id="finishJobIfActive">
        UPDATE
            dm_exec_auto_job
        SET
            status   = 'FINISH',
            end_time = NOW()
        WHERE
            id         = #{jobId}
            AND
            status NOT IN ('FAILED', 'FINISH', 'TERMINATION')
    </update>

    <update id="pauseJobIfActive">
        UPDATE
            dm_exec_auto_job
        SET
            status = 'PAUSE'
        WHERE
            id         = #{jobId}
            AND
            status NOT IN ('PAUSE', 'FAILED', 'FINISH', 'TERMINATION')
    </update>

    <update id="retryJob">
        UPDATE
            dm_exec_auto_job
        SET
            status = 'INIT',
            normal = 1
        WHERE
            id = #{jobId}
    </update>

    <update id="updateReportTime">
        UPDATE
            dm_exec_auto_job
        SET
            last_report_time = NOW()
        WHERE
            id IN
            <foreach collection="jobIdList" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
    </update>

    <update id="startJob">
        UPDATE
            dm_exec_auto_job
        SET
            status           = 'EXECUTING',
            last_report_time = NOW()
        WHERE
            id                = #{jobId}
            AND
            worker_seq_number = #{wsn}
            AND
            status            = 'WAIT_EXEC'
    </update>

    <update id="startPreparedJob">
        UPDATE
            dm_exec_auto_job
        SET
            status = 'INIT',
            uid    = #{uid}
        WHERE
            id     = #{jobId}
            AND
            status = 'PREPARING'
    </update>

    <update id="claimJobForPackaging">
        UPDATE
            dm_exec_auto_job
        SET
            status           = 'PACKAGING',
            last_report_time = NOW()
        WHERE
            id     = #{jobId}
            AND
            status = 'INIT'
    </update>

    <update id="heartbeatPackaging">
        UPDATE
            dm_exec_auto_job
        SET
            last_report_time = NOW()
        WHERE
            id     = #{jobId}
            AND
            status = 'PACKAGING'
    </update>

    <update id="updateOverOutJob">
        UPDATE
            dm_exec_auto_job
        SET
            status = 'INIT'
        WHERE
            #{date} <![CDATA[ > ]]> last_report_time
            AND
            status IN ('PACKAGING', 'WAIT_EXEC')
    </update>

    <update id="updateQueryIdByJobId">
        UPDATE
            dm_exec_auto_job
        SET
            query_id = #{queryId}
        WHERE
            id = #{jobId}
    </update>

    <update id="updateWorkerErrorJob">
        UPDATE
            dm_exec_auto_job
        SET
            status = 'PAUSE',
            normal = 0
        WHERE
            worker_seq_number = #{wsn}
            AND
            status            IN ('EXECUTING', 'PAUSING')
    </update>

    <update id="finishJob">
        UPDATE
            dm_exec_auto_job
        SET
            status   = 'FINISH',
            end_time = NOW()
        WHERE
            id = #{jobId}
    </update>

    <update id="updateWorkerWaitExecuteJob">
        UPDATE
            dm_exec_auto_job
        SET
            status = 'INIT'
        WHERE
            worker_seq_number = #{wsn}
            AND
            status            = 'WAIT_EXEC'
    </update>

    <select id="queryByBizId" resultMap="autoExecJobDO">
        SELECT
            <include refid="sqlJob"/>
        FROM
            dm_exec_auto_job
        WHERE
            biz_id = #{bizId}
    </select>

    <select id="queryByBizIdForUpdate"
            resultMap="autoExecJobDO">
        SELECT
            <include refid="sqlJob"/>
        FROM
            dm_exec_auto_job
        WHERE
            biz_id = #{bizId}
        FOR UPDATE
    </select>

    <select id="listUnFinishJobIdList" resultType="java.lang.Long">
        SELECT
            id
        FROM
            dm_exec_auto_job
        WHERE
            status = 'INIT'
            AND
            #{time} <![CDATA[ >= ]]> schedule_time
        ORDER BY schedule_time ASC
        LIMIT 20
    </select>

    <select id="listOverTimeJobIdList" resultType="java.lang.Long">
        SELECT
            id
        FROM
            dm_exec_auto_job
        WHERE
            status = 'INIT'
            AND
            #{time} <![CDATA[ >= ]]> next_dispatch_time
        ORDER BY next_dispatch_time ASC
        LIMIT 20
    </select>

    <select id="queryByIdForUpdate" resultMap="autoExecJobDO">
        SELECT
            <include refid="sqlJob"/>
        FROM
            dm_exec_auto_job
        WHERE
            id = #{id}
        FOR UPDATE
    </select>

    <select id="queryByDependOnBizId" resultMap="autoExecJobDO">
        SELECT
            <include refid="sqlJob"/>
        FROM
            dm_exec_auto_job
        WHERE
            depend_on_biz_id = #{bizId}
    </select>

    <select id="queryErrorJob" resultMap="autoExecJobDO">
        SELECT
            <include refid="sqlJob"/>
        FROM
            dm_exec_auto_job
        WHERE
            worker_seq_number = #{wsn}
            AND
            status            IN ('EXECUTING', 'PAUSING')
    </select>
</mapper>
