<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.gitops.DmGitOpsScmMapper">
    <resultMap id="dmGitOpsScmDO" type="com.clougence.clouddm.platform.dal.model.gitops.DmGitOpsScmDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="owner_uid" property="ownerUid"/>
        <result column="scm_type" property="scmType"
                javaType="com.clougence.clouddm.platform.dal.model.gitops.ScmType"/>
        <result column="scm_display" property="scmDisplay"/>
        <result column="scm_service_url" property="scmServiceUrl"/>
        <result column="scm_access_token" property="scmAccessToken"/>
    </resultMap>

    <sql id="dmGitOpsScmColumns">
        id
        ,
        gmt_create,
        gmt_modified,
        owner_uid,
        scm_type,
        scm_display,
        scm_service_url,
        scm_access_token
    </sql>

    <select id="queryListByOwner" resultMap="dmGitOpsScmDO">
        SELECT
            <include refid="dmGitOpsScmColumns"/>
        FROM
            dm_git_ops_scm
        WHERE
            owner_uid = #{ownerUid}
    </select>

    <select id="queryListByOwnerAndIds" resultMap="dmGitOpsScmDO">
        SELECT
            <include refid="dmGitOpsScmColumns"/>
        FROM
            dm_git_ops_scm
        WHERE
            owner_uid = #{ownerUid}
            AND
            id        IN
            <foreach collection="scmIds" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
    </select>

    <select id="queryByOwnerAndId" resultMap="dmGitOpsScmDO">
        SELECT
            <include refid="dmGitOpsScmColumns"/>
        FROM
            dm_git_ops_scm
        WHERE
            owner_uid = #{ownerUid}
            AND
            id        = #{scmId}
        LIMIT 1
    </select>

    <delete id="deleteByOwnerAndId">
        DELETE FROM
            dm_git_ops_scm
        WHERE
            owner_uid = #{ownerUid}
            AND
            id        = #{scmId}
    </delete>

    <update id="updateDisplayByOwnerAndId">
        UPDATE
            dm_git_ops_scm
        SET
            scm_display  = #{newData},
            gmt_modified = NOW()
        WHERE
            owner_uid = #{ownerUid}
            AND
            id        = #{scmId}
    </update>

    <update id="updateTokenByOwnerAndId">
        UPDATE
            dm_git_ops_scm
        SET
            scm_access_token = #{newData},
            gmt_modified     = NOW()
        WHERE
            owner_uid = #{ownerUid}
            AND
            id        = #{scmId}
    </update>

    <update id="updateUrlByOwnerAndId">
        UPDATE
            dm_git_ops_scm
        SET
            scm_service_url = #{newData},
            gmt_modified    = NOW()
        WHERE
            owner_uid = #{ownerUid}
            AND
            id        = #{scmId}
    </update>
</mapper>
