<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.datasource.DmDsMetaConfigMapper">
    <resultMap id="metaConfigDO" type="com.clougence.clouddm.platform.dal.model.datasource.DmDsMetaConfigDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="ds_id" property="dsId"/>
        <result column="path" property="path"/>
        <result column="masking" property="masking"/>
    </resultMap>

    <sql id="allColumns">
        id,
        gmt_create,
        gmt_modified,
        ds_id,
        path,
        masking
    </sql>

    <select id="selectAllByDsId" resultMap="metaConfigDO">
        SELECT
            <include refid="allColumns"/>
        FROM
            dm_ds_meta_config
        WHERE
            ds_id = #{dsId}
            AND
            path  IN
            <foreach collection="paths" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
    </select>
</mapper>
