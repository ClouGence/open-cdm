<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.datasource.DmDsUsageMapper">

    <resultMap id="rdpDsUsageDO" type="com.clougence.clouddm.platform.dal.model.datasource.DmDsUsageDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="ds_id" property="dsId"/>
        <result column="res_type" property="resType"
                javaType="com.clougence.clouddm.platform.dal.model.ResourceType"/>
        <result column="res_id" property="resId"/>
        <result column="res_instance_id" property="resInstanceId"/>
    </resultMap>

    <sql id="rdpDsUsage">
        id
        ,
        gmt_create,
        gmt_modified,
        ds_id,
        res_type,
        res_id,
        res_instance_id
    </sql>

    <select id="listByDsId" resultMap="rdpDsUsageDO">
        SELECT
        <include refid="rdpDsUsage"/>
        FROM
        dm_ds_usage
        WHERE
        ds_id = #{dsId}
    </select>

    <select id="listByRes" resultMap="rdpDsUsageDO">
        SELECT
        <include refid="rdpDsUsage"/>
        FROM
        dm_ds_usage
        WHERE
        ds_id = #{dsId}
        AND res_id = #{resId}
        AND res_type = #{resType,javaType=com.clougence.clouddm.platform.dal.model.ResourceType}
        AND res_instance_id = #{resInstanceId}
    </select>

    <delete id="deleteByRes">
        DELETE
        FROM dm_ds_usage
        WHERE ds_id = #{dsId}
          AND res_id = #{resId}
          AND res_type = #{resType,javaType=com.clougence.clouddm.platform.dal.model.ResourceType}
          AND res_instance_id = #{resInstanceId}
    </delete>
</mapper>
