<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.approval.DmApprovalPersonMapper">
    <resultMap id="rdpApprovalPersonDO" type="com.clougence.clouddm.platform.dal.model.approval.DmApprovalPersonDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="ticket_bz_id" property="ticketBzId"/>
        <result column="person_uid" property="personUid"/>
    </resultMap>

    <sql id="rdpApprovalPersonList">
        id,
        gmt_create,
        gmt_modified,
        ticket_bz_id,
        person_uid
    </sql>

    <insert id="insertPersonBatch">
        INSERT INTO
            dm_approval_person
            (
                ticket_bz_id,
                person_uid
            )
        VALUES
            <foreach collection="cacheList" item="item" separator=",">
                (
                    #{item.ticketBzId},
                    #{item.personUid}
                )
            </foreach>
    </insert>

    <delete id="deleteByTicketBzId">
        DELETE FROM
            dm_approval_person
        WHERE
            ticket_bz_id = #{ticketBzId}
    </delete>

    <select id="queryByTicketBzId" resultType="com.clougence.clouddm.platform.dal.model.approval.DmApprovalPersonDO">
        SELECT
            <include refid="rdpApprovalPersonList"/>
        FROM
            dm_approval_person
        WHERE
            ticket_bz_id = #{ticketBzId}
    </select>
</mapper>
