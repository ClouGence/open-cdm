<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.cicd.DmChangeItemMapper">
    <resultMap id="dmChangeItemDO" type="com.clougence.clouddm.platform.dal.model.cicd.DmChangeItemDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="owner_uid" property="ownerUid"/>
        <result column="ref_flow_id" property="refFlowId"/>
        <result column="ref_change_id" property="refChangeId"/>
        <result column="ref_change_item_type" property="refChangeItemType"
                javaType="com.clougence.clouddm.platform.dal.model.cicd.ChangeItemType"/>
        <result column="content_name" property="contentName"/>
        <result column="content_index" property="contentIndex"/>
        <result column="content" property="content"/>
    </resultMap>
    <sql id="dmChangeItemDO_select">
        id
        , gmt_create, gmt_modified, owner_uid, ref_flow_id, ref_change_id, ref_change_item_type,
        content_name, content_index, content
    </sql>
    <select id="queryChangeItemByChangeId" resultMap="dmChangeItemDO">
        select
        <include refid="dmChangeItemDO_select"/>
        from dm_change_item
        where owner_uid = #{ownerUid} and ref_change_id = #{refChangeId} and ref_change_item_type = #{itemType}
        order by content_index asc
    </select>
    <delete id="deleteByChangeItemType">
        delete
        from dm_change_item
        where owner_uid = #{ownerUid}
          and ref_change_id = #{refChangeId}
          and ref_change_item_type = #{itemType}
    </delete>
    <delete id="deleteByChangeItemAll">
        delete
        from dm_change_item
        where owner_uid = #{ownerUid}
          and ref_change_id = #{refChangeId}
    </delete>
</mapper>

