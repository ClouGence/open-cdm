<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.ai.DmAiHistoryEventMapper">
    <resultMap id="event" type="com.clougence.clouddm.platform.dal.model.ai.DmAiHistoryEventDO">
        <result column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="history_id" property="historyId"/>
        <result column="event_type" property="eventType"/>
        <result column="event_data" property="eventData"
                typeHandler="com.clougence.clouddm.platform.dal.handler.encrypt.StrSecretTypeHandler"/>
    </resultMap>

    <sql id="columns">id, session_id, history_id, event_type, event_data</sql>

    <select id="findByHistoryIds" resultMap="event">
        SELECT
            <include refid="columns"/>
        FROM
            dm_ai_event
        WHERE
            history_id IN
        <foreach collection="historyIds" item="historyId" open="(" separator="," close=")">
            #{historyId}
        </foreach>
        <if test="lock">
            FOR UPDATE
        </if>
    </select>

    <delete id="deleteByHistoryIdAndType">
        DELETE FROM
            dm_ai_event
        WHERE
            history_id = #{historyId}
            AND
            event_type = #{type}
    </delete>

    <delete id="deleteBySessionIdFromHistoryId">
        DELETE FROM
            dm_ai_event
        WHERE
            session_id = #{sessionId}
            AND
            history_id <![CDATA[ >= ]]> #{historyId}
    </delete>

    <delete id="deleteBySessionId">
        DELETE FROM
            dm_ai_event
        WHERE
            session_id = #{sessionId}
    </delete>
</mapper>
