<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.system.DmSshConfigMapper">

    <resultMap id="dmSshConfigDO" type="com.clougence.clouddm.platform.dal.model.datasource.DmSshConfigDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="name" property="name"/>
        <result column="host" property="host"/>
        <result column="port" property="port"/>
        <result column="username" property="username"/>
        <result column="auth_type" property="authType"/>
        <result column="password" property="password"/>
        <result column="private_key_data" property="privateKeyData"/>
        <result column="private_key_passphrase" property="privateKeyPassphrase"/>
        <result column="con_features" property="conFeatures"/>
        <result column="proxy_type" property="proxyType"/>
        <result column="proxy_features" property="proxyFeatures"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="dmSshConfigDO_select">
        id,
        gmt_create,
        gmt_modified,
        name,
        host,
        port,
        username,
        auth_type,
        password,
        private_key_data,
        private_key_passphrase,
        con_features,
        proxy_type,
        proxy_features,
        deleted
    </sql>

    <select id="queryList" resultMap="dmSshConfigDO">
        SELECT
            <include refid="dmSshConfigDO_select"/>
        FROM dm_ssh_config
        WHERE deleted = 0
        <if test="search != null and search != ''">
            AND (
                name LIKE CONCAT('%', #{search}, '%')
                OR host LIKE CONCAT('%', #{search}, '%')
                OR username LIKE CONCAT('%', #{search}, '%')
            )
        </if>
        ORDER BY gmt_modified DESC, id DESC
    </select>

    <select id="queryById" resultMap="dmSshConfigDO">
        SELECT
            <include refid="dmSshConfigDO_select"/>
        FROM dm_ssh_config
        WHERE id = #{id} AND deleted = 0
        LIMIT 1
    </select>

    <update id="markDeleted">
        UPDATE dm_ssh_config
        SET deleted = 1, gmt_modified = NOW()
        WHERE id = #{id}
        LIMIT 1
    </update>
</mapper>
