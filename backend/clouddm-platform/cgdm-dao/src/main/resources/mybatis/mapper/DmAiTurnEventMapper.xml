<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.ai.DmAiTurnEventMapper">
    <resultMap id="event" type="com.clougence.clouddm.platform.dal.model.ai.DmAiTurnEventDO">
        <result column="id" property="id"/>
        <result column="run_id" property="runId"/>
        <result column="uid" property="uid"/>
        <result column="session_id" property="sessionId"/>
        <result column="history_id" property="historyId"/>
        <result column="seq" property="seq"/>
        <result column="event_type" property="eventType"/>
        <result column="event_data" property="eventData"
                typeHandler="com.clougence.clouddm.platform.dal.handler.encrypt.StrSecretTypeHandler"/>
        <result column="created_ms" property="createdMs"/>
    </resultMap>

    <select id="findByRunIdAfterSeq" resultMap="event">
        SELECT
            id,
            run_id,
            uid,
            session_id,
            history_id,
            seq,
            event_type,
            event_data,
            created_ms
        FROM
            dm_ai_turn_event
        WHERE
            run_id = #{runId}
            AND
            seq <![CDATA[ > ]]> #{seq}
        ORDER BY seq
    </select>

    <delete id="deleteBySessionIdFromHistoryId">
        DELETE FROM
            dm_ai_turn_event
        WHERE
            session_id = #{sessionId}
            AND
            history_id <![CDATA[ >= ]]> #{historyId}
    </delete>

    <delete id="deleteBySessionId">
        DELETE FROM
            dm_ai_turn_event
        WHERE
            session_id = #{sessionId}
    </delete>
</mapper>
