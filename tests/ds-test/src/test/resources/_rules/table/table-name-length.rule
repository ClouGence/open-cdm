#define "length" as int
        default "30"
        hint "表名的最大长度"

if @domain.sqlType in ['CREATE_TABLE'] then
  checkName = @domain.table
elseif @domain.sqlType in ['RENAME_TABLE', 'RENAME_TABLE'] then
  checkName = @domain.newName
else
  return true
end

return @func.string.length(checkName) <= cast(#{length} as int)