<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drivers bundled into the release distributions, both tgz packages and Docker
  images (shipped at <APP_HOME>/built-in-drivers, resolved at build time by
  package/pkg/builtin-drivers:generateBuiltinDrivers).

  IMPORTANT: driverFamily / version / maven coordinate must exactly match the
  corresponding plugin drivers.xml entry (backend/clouddm-plugins/clouddm-ds/...),
  otherwise the runtime files.idx resource id will not match and the bundled
  driver will be ignored.
-->
<drivers>
    <driver driverFamily="MySQL Connector/J" version="8.4.0">
        <resource type="maven">com.mysql:mysql-connector-j:8.4.0</resource>
    </driver>
    <driver driverFamily="PostgreSQL JDBC" version="42.7.10">
        <resource type="maven">org.postgresql:postgresql:42.7.10</resource>
    </driver>
    <driver driverFamily="MariaDB Java Client" version="3.5.8">
        <resource type="maven">org.mariadb.jdbc:mariadb-java-client:3.5.8</resource>
    </driver>
    <driver driverFamily="Oracle JDBC Driver" version="23.26.2.0.0">
        <resource type="maven">com.oracle.database.jdbc:ojdbc11:23.26.2.0.0</resource>
        <resource type="maven">com.oracle.database.xml:xdb:23.26.2.0.0</resource>
        <resource type="maven">com.oracle.database.xml:xmlparserv2:23.26.2.0.0</resource>
        <resource type="maven">com.oracle.database.nls:orai18n:23.26.2.0.0</resource>
    </driver>
    <driver driverFamily="SQL Server JDBC Driver" version="13.4.0">
        <resource type="maven">com.microsoft.sqlserver:mssql-jdbc:13.4.0.jre8</resource>
    </driver>
    <driver driverFamily="IBM JTOpen" version="21.0.6">
        <resource type="maven">net.sf.jt400:jt400:21.0.6</resource>
    </driver>
    <driver driverFamily="Dameng JDBC Driver" version="8.1.3.140">
        <resource type="maven">com.dameng:DmJdbcDriver18:8.1.3.140</resource>
    </driver>
    <driver driverFamily="ODPS JDBC" version="3.10.5">
        <resource type="maven">com.aliyun.odps:odps-jdbc:3.10.5</resource>
    </driver>
    <driver driverFamily="MongoDB Driver" version="5.9.0">
        <resource type="maven">org.mongodb:mongodb-driver-sync:5.9.0</resource>
    </driver>
    <driver driverFamily="ClickHouse JDBC" version="0.9.7">
        <resource type="maven">com.clickhouse:clickhouse-jdbc:0.9.7</resource>
    </driver>
    <driver driverFamily="Jedis" version="7.4.1">
        <resource type="maven">redis.clients:jedis:7.4.1</resource>
    </driver>
</drivers>
